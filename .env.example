# =============================================================================
# Curato AI — Environment Variables
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://curato:curato_secret@localhost:5432/curato_ai
DATABASE_URL_SYNC=postgresql://curato:curato_secret@localhost:5432/curato_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API (Search & News)
TAVILY_API_KEY=your_tavily_api_key_here

# Reddit API (Social Trends)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Firecrawl API (Web Scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# LLM Configuration (defaults)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_MAX_TOKENS=4096

# Application
APP_NAME=Curato AI
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth (stubbed — configure when ready)
# AUTH_PROVIDER=clerk
# CLERK_SECRET_KEY=sk_test_xxx
# CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Google Integrations (not implemented yet)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-sa.json
# GOOGLE_DOCS_TEMPLATE_ID=
# GOOGLE_SHEETS_ID=

# Agent Retry Configuration
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY_SECONDS=2
